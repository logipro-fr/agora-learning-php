# environnement de travail
# test intégration continue
APP_ENV=dev
APP_DEBUG=1

# compositions des urls
# APP_URL_PREFIX="/AgoraLearningPhp"
# APP_HOST="localhost"

# tests d'intégration (composer test-integration)
# Les valeurs propres au poste et la clé API vont dans .env.local (non versionné).
# URL racine de l'instance Agora, vue depuis le conteneur Docker (sans /api/external/v1)
AGORA_BASE_URL=http://172.17.0.1:20280
# Clé API externe : ne jamais la renseigner ici
AGORA_API_KEY=
