# Copié en .env.local par composer install / composer update s'il n'existe pas.
# .env.local n'est pas versionné : y mettre les valeurs propres au poste et les secrets.

# URL racine de l'instance Agora, vue depuis le conteneur Docker (sans /api/external/v1)
# AGORA_BASE_URL=http://172.17.0.1:20280

# Clé API externe de l'instance Agora
AGORA_API_KEY=
